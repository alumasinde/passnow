APP_ENV=development
APP_NAME=PassNow
HTTP_ADDR=:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gatepass
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
BCRYPT_COST=12
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

BASE_DOMAIN=localhost
PLATFORM_BOOTSTRAP_TOKEN=
GATEPASS_WORKER_INTERVAL=1m
APPROVED_GATEPASS_TTL=24h

APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://127.0.0.1:8080
TENANT_HOST=your-tenant.localhost
APP_TIMEZONE=Africa/Nairobi
SESSION_NAME=passnow_session
SESSION_SECURE=0
SESSION_SAMESITE=Lax
CSRF_TTL=3600
API_TIMEOUT=15
PAGE_SIZE=20
FONT_AWESOME_URL=https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css

# Database-per-tenant (Phase A)
# Generate once and keep secret: 32 random bytes encoded as base64.
TENANT_DB_ENCRYPTION_KEY= 
TENANT_DB_MAX_OPEN_CONNS=10
TENANT_DB_MAX_IDLE_CONNS=5
TENANT_DB_CONN_MAX_LIFETIME=5m

# Optional provisioning account used to create tenant databases.
# Give this account only the CREATE DATABASE privileges it needs.
DB_PROVISION_HOST=127.0.0.1
DB_PROVISION_PORT=3306
DB_PROVISION_USER=
DB_PROVISION_PASSWORD=
