APP_ENV=development
HTTP_ADDR=:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gatepass_app
DB_PASSWORD=changeme
DB_NAME=gatepass

JWT_SECRET=replace-with-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

BASE_DOMAIN=gatepass.example.com

# Set this to provision your first tenant via POST /api/v1/platform/bootstrap-tenant
# (send it as header X-Bootstrap-Token). Unset/rotate it once your tenants exist.
PLATFORM_BOOTSTRAP_TOKEN=changeme-generate-a-random-value