# Application
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
BASE_DOMAIN=localhost

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=passnow
DB_PASSWORD=change-me
DB_NAME=gatepass
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Authentication
# Generate a random value of at least 32 characters for real deployments.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# Platform bootstrap
# Leave empty after initial tenant provisioning.
PLATFORM_BOOTSTRAP_TOKEN=

# Workers
GATEPASS_WORKER_INTERVAL=1m
APPROVED_GATEPASS_TTL=24h
